# GitHub Personal Access Token (required)
# Generate at: https://github.com/settings/tokens
# Required scopes: repo, read:org, read:user, read:project
GITHUB_TOKEN=your_github_personal_access_token_here

# GitHub API base URL (optional — override for GitHub Enterprise)
# Default: https://api.github.com
GITHUB_API_URL=https://api.github.com

# Default owner/org for operations when not explicitly specified (optional)
GITHUB_DEFAULT_OWNER=

# MCP server transport: stdio (default) or sse
MCP_TRANSPORT=stdio
